{
  // Type-checks vite.config.ts, which runs in Node. Vite runs it itself, so tsc only checks types.
  "extends": "@saas/config-typescript/node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vite.config.ts"]
}
