# Copy this file to .env and change the values for your machine.
# .env is ignored by git, so never put real secrets in this example file.

# Port the API listens on
PORT=3000

# Postgres connection used when you run the API on your machine (pnpm dev).
# Uses "localhost" because compose.yaml exposes the database on port 5432.
# Inside Docker, compose.yaml sets its own DATABASE_URL with the "db" hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas-boilerplate
