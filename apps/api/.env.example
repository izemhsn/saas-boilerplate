# Copy this file to .env and change the values for your machine.
# .env is ignored by git, so never put real secrets in this example file.

# Port the API listens on
PORT=3000

# Postgres connection used when you run the API on your machine (pnpm dev).
# Uses "localhost" because compose.yaml exposes the database on port 5432.
# Inside Docker, compose.yaml sets its own DATABASE_URL with the "db" hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas-boilerplate

# Secret Better Auth uses to sign session cookies (at least 32 characters).
# Left empty on purpose: the API won't start until you paste your own. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (or: openssl rand -base64 32). Use a different one on each server and never share it.
BETTER_AUTH_SECRET=

# The URL people open in the browser, not the API's own port. Better Auth uses it for links
# and rejects requests coming from other sites. In dev that's the Vite app, which forwards
# /api to the API. In Docker, compose.yaml sets it (http://localhost:8080 unless you export
# BETTER_AUTH_URL, see the README).
BETTER_AUTH_URL=http://localhost:5173

# The API docs at /api/docs (every endpoint, with "try it"). Leave this commented out for the default:
# on while developing, off in production (compose.yaml sets NODE_ENV=production).
# Set to true to show them in production too, but only where you trust everyone who can reach
# the site: the page lists every endpoint and loads a script from a CDN.
# API_DOCS_ENABLED=true
